{
  "name": "wattbike-bmx-race",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n bike-connector,web -c cyan,green \"npm:bridge\" \"npm:web\"",
    "dev:ant": "concurrently -k -n ant-bridge,web -c cyan,green \"npm:bridge:ant\" \"npm:web\"",
    "dev:ble": "concurrently -k -n ble-bridge,web -c cyan,green \"npm:bridge:ble\" \"npm:web\"",
    "dev:sim": "concurrently -k -n sim-bridge,web -c cyan,green \"npm:bridge:sim\" \"npm:web\"",
    "web": "vite --host 127.0.0.1",
    "bridge": "node bridge/server.mjs",
    "bridge:ant": "WATTBIKE_INPUT=ant node bridge/server.mjs",
    "bridge:ble": "WATTBIKE_INPUT=ble node bridge/server.mjs",
    "bridge:sim": "WATTBIKE_INPUT=sim node bridge/server.mjs",
    "start": "node cloud/server.mjs",
    "cloud": "npm run build && node cloud/server.mjs",
    "ant:capture": "node scripts/capture-ant-wattbike.mjs",
    "ble:inspect": "node bridge/ble-inspector.mjs",
    "db:migrate:tracklab": "node scripts/migrate-tracklab-postgres.mjs",
    "assets:clean": "node scripts/clean-sprite-alpha.mjs",
    "assets:rider-rigs": "node scripts/extract-rider-rig-bases.mjs",
    "assets:pull-sled": "node scripts/build-clean-pull-sled-asset.mjs",
    "tracks:import:usabmx": "node scripts/import-usabmx-tracks.mjs",
    "tracks:import:ffc": "node scripts/import-ffc-bmx-tracks.mjs",
    "tracks:import:bmxnz": "node scripts/import-bmxnz-tracks.mjs",
    "tracks:import:auscycling": "node scripts/import-auscycling-tracks.mjs",
    "tracks:import:osm": "node scripts/import-osm-bmx-tracks.mjs",
    "tracks:import:official": "npm run tracks:import:usabmx && npm run tracks:import:ffc && npm run tracks:import:bmxnz && npm run tracks:import:auscycling",
    "tracks:build": "node scripts/build-track-database.mjs && node scripts/validate-track-database.mjs",
    "tracks:validate": "node scripts/validate-track-database.mjs",
    "tracks:social:audit": "node scripts/audit-track-social-links.mjs",
    "billing:square:setup": "node scripts/setup-square-billing.mjs",
    "billing:square:sync-render": "node scripts/sync-render-square-env.mjs",
    "commentary:research:usabmx": "python3 scripts/analyze-usabmx-commentary.py --years 2024 2025 2026 --playlist-end 900 --output data/commentary/usabmx-national-analysis.json",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run tracks:build && npm run typecheck && vite build && node scripts/compress-dist-assets.mjs && node scripts/check-bundle-budget.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e:install": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:unit": "vitest run",
    "test": "npm run test:unit && npm run test:e2e",
    "verify:release": "npm audit --omit=dev --omit=optional --audit-level=high && npm run build && npm run test:unit",
    "verify:release:full": "npm run verify:release && npm run test:e2e",
    "smoke:deployment": "node scripts/smoke-deployment.mjs",
    "probe:load": "node scripts/probe-runtime-load.mjs",
    "mobile:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:build": "npm run mobile:sync && node scripts/build-ios-unsigned.mjs"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "lucide-react": "^0.562.0",
    "pg": "^8.22.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.2.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@abandonware/noble": "^1.9.2-26",
    "ant-plus-next": "^0.4.0",
    "serialport": "^13.0.0"
  },
  "overrides": {
    "node-gyp": "^13.0.0",
    "tar": "^7.5.19"
  }
}
