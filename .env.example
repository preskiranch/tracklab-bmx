VITE_GOOGLE_MAPS_API_KEY=
VITE_WATTBIKE_BRIDGE_URL=ws://127.0.0.1:8787

# Additional website origins allowed to access the local Bike Connector.
# The production TrackLab Render origin and local development are allowed by default.
TRACKLAB_ALLOWED_ORIGINS=

# Comma-separated account emails that receive TrackLab administrator access.
TRACKLAB_ADMIN_EMAILS=preskiranch@gmail.com

# Server-only Square billing values for Render.
# Use sandbox while testing, then production after the Square plans are live.
SQUARE_ENVIRONMENT=sandbox
SQUARE_VERSION=2026-05-20
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_RACER_PLAN_VARIATION_1_BIKE=
SQUARE_RACER_PLAN_VARIATION_2_BIKES=
SQUARE_RACER_PLAN_VARIATION_3_BIKES=
SQUARE_RACER_PLAN_VARIATION_4_BIKES=
