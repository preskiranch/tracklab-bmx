VITE_GOOGLE_MAPS_API_KEY=
# Server-only key for Google Routes and Elevation APIs. Keep this out of the browser bundle.
GOOGLE_ROUTES_API_KEY=
# Server-held, domain-restricted Apple MapKit JS token for the developer-only
# Explore map comparison. The browser receives it only after an admin session check.
APPLE_MAPKIT_JS_TOKEN=
VITE_WATTBIKE_BRIDGE_URL=ws://127.0.0.1:8787

# Additional website origins allowed to access the local Bike Connector.
# The production TrackLab Render origin and local development are allowed by default.
TRACKLAB_ALLOWED_ORIGINS=

# Comma-separated account emails that receive TrackLab administrator access.
TRACKLAB_ADMIN_EMAILS=preskiranch@gmail.com

# Server-only, one-time provisioning secret for the reserved Preski Ranch and
# founder Friends accounts. Use at least 32 random characters and rotate or
# remove it after both immutable account bindings have been created.
TRACKLAB_OFFICIAL_ACCOUNT_BOOTSTRAP_TOKEN=

# Production observability. Keep the metrics token server-side and use it as a
# bearer token when scraping GET /api/metrics.
TRACKLAB_METRICS_TOKEN=
# Log every completed HTTP request when set to 1. Server failures, rate limits,
# aborted requests, and slow requests are logged regardless of this setting.
TRACKLAB_LOG_HTTP=0
TRACKLAB_SLOW_REQUEST_MS=1000

# Server-only Apple Push Notification service configuration. Development may
# leave APNs disabled. Production must provision the secrets described in
# docs/operations/apns-notifications.md before setting enabled to 1.
TRACKLAB_APNS_ENABLED=0
TRACKLAB_APNS_TEAM_ID=
TRACKLAB_APNS_KEY_ID=
TRACKLAB_APNS_PRIVATE_KEY=
# Exactly 32 random bytes encoded as standard base64. Keep both secrets out of
# client builds and preserve secure backups; the fingerprint key is stable.
TRACKLAB_PUSH_TOKEN_ENCRYPTION_KEY=
TRACKLAB_PUSH_TOKEN_FINGERPRINT_KEY=
TRACKLAB_PUSH_TOKEN_KEY_VERSION=1
# Optional JSON key ring during staged encryption-key rotation, for example
# {"1":"<previous 32-byte standard-base64 key>"}. Maximum four old keys.
TRACKLAB_PUSH_TOKEN_PREVIOUS_ENCRYPTION_KEYS=

# Apple StoreKit subscriptions for paid Wattbike connections. TestFlight
# transactions use Apple's sandbox even when the app is production signed.
TRACKLAB_APPLE_IAP_ENABLED=0
# Separate release switch. Leave at 0 until Apple production purchase,
# notifications, legacy Square cancellation, and paid-service obligations pass.
TRACKLAB_APPLE_ONLY_CUTOVER=0
TRACKLAB_APPLE_BUNDLE_ID=com.preskilranch.tracklabbmx
# Numeric Apple ID from App Store Connect (not the bundle identifier).
TRACKLAB_APPLE_APP_ID=
# Numeric identifier assigned to the single Wattbike Connections group.
TRACKLAB_APPLE_SUBSCRIPTION_GROUP_ID=
# App Store Connect In-App Purchase API key credentials. Keep the .p8 private
# key server-only; literal PEM, escaped newlines, or base64 PEM are accepted.
TRACKLAB_APPLE_ISSUER_ID=
TRACKLAB_APPLE_KEY_ID=
TRACKLAB_APPLE_PRIVATE_KEY=
# Comma-separated TrackLab account UUIDs allowed to use Sandbox/TestFlight.
TRACKLAB_APPLE_SANDBOX_ACCOUNT_TOKENS=
# Server backstop for transactionless/missed notifications. The minimum
# interval is 60 seconds and each pass processes at most 200 lineages.
TRACKLAB_APPLE_RECONCILE_INTERVAL_MS=900000
TRACKLAB_APPLE_RECONCILE_BATCH_SIZE=100

# Release-smoke expectations. These are client-side deployment checks, not app
# service configuration. Set them in the shell or Deployment Smoke workflow
# that calls scripts/smoke-deployment.mjs.
TRACKLAB_EXPECT_APPLE_IAP=0
TRACKLAB_EXPECT_APPLE_ONLY_CUTOVER=0
